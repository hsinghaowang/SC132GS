/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Thundercomm, Inc. RUBIK Pi 3";
	compatible = "qcom,qcm6490-addons-idp\0qcom,sc7280";
	qcom,msm-id = <0x1f1 0x10000 0x1f2 0x10000 0x1db 0x10000 0x203 0x10000>;
	qcom,board-id = <0x20 0x0b 0x20 0x60b>;

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		i2c0 = "/soc@0/geniqup@9c0000/i2c@980000";
		i2c1 = "/soc@0/geniqup@9c0000/i2c@984000";
		i2c2 = "/soc@0/geniqup@9c0000/i2c@988000";
		i2c3 = "/soc@0/geniqup@9c0000/i2c@98c000";
		i2c4 = "/soc@0/geniqup@9c0000/i2c@990000";
		i2c5 = "/soc@0/geniqup@9c0000/i2c@994000";
		i2c6 = "/soc@0/geniqup@9c0000/i2c@998000";
		i2c7 = "/soc@0/geniqup@9c0000/i2c@99c000";
		i2c8 = "/soc@0/geniqup@ac0000/i2c@a80000";
		i2c9 = "/soc@0/geniqup@ac0000/i2c@a84000";
		i2c10 = "/soc@0/geniqup@ac0000/i2c@a88000";
		i2c11 = "/soc@0/geniqup@ac0000/i2c@a8c000";
		i2c12 = "/soc@0/geniqup@ac0000/i2c@a90000";
		i2c13 = "/soc@0/geniqup@ac0000/i2c@a94000";
		i2c14 = "/soc@0/geniqup@ac0000/i2c@a98000";
		i2c15 = "/soc@0/geniqup@ac0000/i2c@a9c000";
		mmc0 = "/soc@0/mmc@7c4000";
		mmc1 = "/soc@0/mmc@8804000";
		spi0 = "/soc@0/geniqup@9c0000/spi@980000";
		spi1 = "/soc@0/geniqup@9c0000/spi@984000";
		spi2 = "/soc@0/geniqup@9c0000/spi@988000";
		spi3 = "/soc@0/geniqup@9c0000/spi@98c000";
		spi4 = "/soc@0/geniqup@9c0000/spi@990000";
		spi5 = "/soc@0/geniqup@9c0000/spi@994000";
		spi6 = "/soc@0/geniqup@9c0000/spi@998000";
		spi7 = "/soc@0/geniqup@9c0000/spi@99c000";
		spi8 = "/soc@0/geniqup@ac0000/spi@a80000";
		spi9 = "/soc@0/geniqup@ac0000/spi@a84000";
		spi10 = "/soc@0/geniqup@ac0000/spi@a88000";
		spi11 = "/soc@0/geniqup@ac0000/spi@a8c000";
		spi12 = "/soc@0/geniqup@ac0000/spi@a90000";
		spi13 = "/soc@0/geniqup@ac0000/spi@a94000";
		spi14 = "/soc@0/geniqup@ac0000/spi@a98000";
		spi15 = "/soc@0/geniqup@ac0000/spi@a9c000";
		serial0 = "/soc@0/geniqup@9c0000/serial@994000";
		serial2 = "/soc@0/geniqup@9c0000/serial@988000";
		serial3 = "/soc@0/geniqup@9c0000/serial@98c000";
		serial6 = "/soc@0/geniqup@9c0000/serial@998000";
		serial7 = "/soc@0/geniqup@9c0000/serial@99c000";
		serial8 = "/soc@0/geniqup@ac0000/serial@a80000";
		serial12 = "/soc@0/geniqup@ac0000/serial@a90000";
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			clock-frequency = <0x493e000>;
			#clock-cells = <0x00>;
			phandle = <0x1ba>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x7ffc>;
			#clock-cells = <0x00>;
			phandle = <0x34>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		wlan-ce@4cd000 {
			no-map;
			reg = <0x00 0x4cd000 0x00 0x1000>;
			phandle = <0xce>;
		};

		hyp@80000000 {
			reg = <0x00 0x80000000 0x00 0x600000>;
			no-map;
			phandle = <0x23b>;
		};

		xbl@80600000 {
			reg = <0x00 0x80700000 0x00 0x100000>;
			no-map;
			phandle = <0x23c>;
		};

		aop@80800000 {
			reg = <0x00 0x80800000 0x00 0x60000>;
			no-map;
			phandle = <0x23d>;
		};

		aop-cmd-db@80860000 {
			reg = <0x00 0x80860000 0x00 0x20000>;
			compatible = "qcom,cmd-db";
			no-map;
			phandle = <0x23e>;
		};

		xbl-uefi-res@80880000 {
			reg = <0x00 0x80884000 0x00 0x10000>;
			no-map;
			phandle = <0x23f>;
		};

		sec-apps@808ff000 {
			reg = <0x00 0x808ff000 0x00 0x1000>;
			no-map;
			phandle = <0x240>;
		};

		smem@80900000 {
			reg = <0x00 0x80900000 0x00 0x200000>;
			no-map;
			phandle = <0x24>;
		};

		cpucp@80b00000 {
			no-map;
			reg = <0x00 0x80b00000 0x00 0x100000>;
			phandle = <0x241>;
		};

		wlan-fw@80c00000 {
			reg = <0x00 0x80c00000 0x00 0xc00000>;
			no-map;
			phandle = <0xcd>;
		};

		video@8b200000 {
			reg = <0x00 0x8a700000 0x00 0x700000>;
			no-map;
			phandle = <0x194>;
		};

		ipa-fw@8b700000 {
			reg = <0x00 0x8b300000 0x00 0x10000>;
			no-map;
			phandle = <0xe1>;
		};

		zap@8b71a000 {
			reg = <0x00 0x8b71a000 0x00 0x2000>;
			no-map;
			phandle = <0xfd>;
		};

		mpss@8b800000 {
			reg = <0x00 0x8b800000 0x00 0xf600000>;
			no-map;
			phandle = <0x101>;
		};

		camera@84300000 {
			reg = <0x00 0x84300000 0x00 0x500000>;
			no-map;
			phandle = <0x242>;
		};

		wpss@84800000 {
			reg = <0x00 0x84800000 0x00 0x1900000>;
			no-map;
			phandle = <0x187>;
		};

		adsp@86100000 {
			reg = <0x00 0x86100000 0x00 0x2800000>;
			no-map;
			phandle = <0x1bc>;
		};

		cdsp@88900000 {
			reg = <0x00 0x88900000 0x00 0x1e00000>;
			no-map;
			phandle = <0x18e>;
		};

		cvp@8ae00000 {
			reg = <0x00 0x8ae00000 0x00 0x500000>;
			no-map;
			phandle = <0x243>;
		};

		ipa-gsi@8b310000 {
			reg = <0x00 0x8b310000 0x00 0xa000>;
			no-map;
			phandle = <0x244>;
		};

		gpu-microcode@8b31a000 {
			reg = <0x00 0x8b31a000 0x00 0x2000>;
			no-map;
			phandle = <0x245>;
		};

		tz-stat@c0000000 {
			reg = <0x00 0xc0000000 0x00 0x100000>;
			no-map;
			phandle = <0x246>;
		};

		tags@c0100000 {
			reg = <0x00 0xc0100000 0x00 0x1200000>;
			no-map;
			phandle = <0x247>;
		};

		qtee@c1300000 {
			reg = <0x00 0xc1300000 0x00 0x500000>;
			no-map;
			phandle = <0x248>;
		};

		trusted_apps@c1800000 {
			reg = <0x00 0xc1800000 0x00 0x1c00000>;
			no-map;
			phandle = <0x249>;
		};

		debug-vm@d0600000 {
			reg = <0x00 0xd0600000 0x00 0x100000>;
			no-map;
			phandle = <0x24a>;
		};

		adsp-heap {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0xc00000>;
			phandle = <0x1be>;
		};

		secure-cdsp-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			phandle = <0x1da>;
		};

		qcom,audio-ml {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x1d4>;
		};

		qcom,qseecom {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x1d8>;
		};

		qcom,qseecom-ta {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x1d9>;
		};

		mem-dump-region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x2c00000>;
			phandle = <0x214>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x03>;
			power-domain-names = "psci";
			next-level-cache = <0x04>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1a>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x04>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x09>;
				};
			};

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x1e8480>;
				exit-latency-us = <0x2710>;
				phandle = <0x1de>;
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x0a>;
			power-domain-names = "psci";
			next-level-cache = <0x0b>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0b>;
			};

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x1e8480>;
				exit-latency-us = <0x2710>;
				phandle = <0x1e0>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			clocks = <0x02 0x00>;
			enable-method = "psci";

	pmic-glink {
		compatible = "qcom,sm8350-pmic-glink\0qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		orientation-gpios = <0x4e 0x8c 0x00>;
		qcom,thermal-mitigation = <0x2dc6c0 0x16e360 0xf4240 0x7a120>;
		qcom,batteryless;
		phandle = <0x382>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x215>;
						phandle = <0x190>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x216>;
						phandle = <0x180>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						remote-endpoint = <0x217>;
						phandle = <0x21d>;
					};
				};
			};
		};
	};

	typec-retimer@1c {
		phandle = <0x383>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-0 = <0x218>;
		pinctrl-names = "default";

		key-volume-up {
			label = "volume_up";
			gpios = <0x1b4 0x06 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x73>;
			wakeup-source;
			debounce-interval = <0x0f>;
			linux,can-disable;
		};
	};

	vreg_sdio_wifi_1p8 {
		compatible = "regulator-fixed";
		pinctrl-0 = <0x219 0x21a 0x21b>;
		pinctrl-names = "default";
		regulator-name = "vreg_sdio_wifi_1p8";
		enable-active-high;
		gpio = <0x4e 0x7d 0x00>;
		regulator-always-on;
		regulator-enable-ramp-delay = <0xc350>;
		phandle = <0x8c>;
	};

	bcmdhd_wlan {
		status = "okay";
		compatible = "linux,bcmdhd_wlan";
		gpio_wl_reg_on = <0x4e 0x10 0x00>;
		gpio_wl_host_wake = <0x4e 0x26 0x00>;
		vdda-supply = <0x8c>;
		phandle = <0x384>;
	};

	usb1-sbu-mux {
		compatible = "pericom,pi3usb102\0gpio-sbu-mux";
		enable-gpios = <0x4e 0x35 0x01>;
		select-gpios = <0x4e 0x34 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x21c>;
		mode-switch;
		orientation-switch;

		port {

			endpoint {
				remote-endpoint = <0x21d>;
				phandle = <0x217>;
			};
		};
	};

	vreg_usb_hub0_1p8 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_usb_hub0_1p8";
		gpio = <0x4e 0x56 0x00>;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		enable-active-high;
		regulator-always-on;
		regulator-enable-ramp-delay = <0xc350>;
		phandle = <0x21e>;
	};

	vreg_usb_eth_1p8 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_usb_eth_1p8";
		gpio = <0x4e 0x07 0x00>;
		vin-supply = <0x21e>;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		enable-active-high;
		regulator-enable-ramp-delay = <0xc350>;
		phandle = <0x21f>;
	};

	vreg_usb_hub0_rest {
		compatible = "regulator-fixed";
		regulator-name = "vreg_usb_hub0_rest";
		gpio = <0x4e 0x88 0x00>;
		vin-supply = <0x21f>;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		enable-active-high;
		regulator-always-on;
		regulator-enable-ramp-delay = <0xc350>;
		phandle = <0xd3>;
	};

	verg_m2_1p8 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_m2_1p8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-enable-ramp-delay = <0xc350>;
		gpio = <0x4e 0x38 0x00>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x385>;
	};

	pwm-fan {
		compatible = "pwm-fan";
		pwms = <0x220 0x03 0xf4240>;
		pinctrl-names = "default";
		pinctrl-0 = <0x221>;
		phandle = <0x386>;
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x222>;
				phandle = <0x9b>;
			};
		};
	};

	sound {
		compatible = "qcom,qcs6490-rubikpi3-sndcard";
		model = "qcs6490-rubikpi3-snd-card";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default\0stub_aif1_active\0stub_aif1_sleep";
		pinctrl-0 = <0x223 0x224 0x225 0x226 0x227 0x228 0x229 0x22a 0x22b 0x22c>;
		pinctrl-1 = <0x22d 0x22e 0x225 0x22f 0x230 0x231 0x232 0x233 0x234 0x235>;
		pinctrl-2 = <0x223 0x224 0x225 0x226 0x227 0x228 0x229 0x22a 0x22b 0x22c>;
		phandle = <0x387>;

		mi2s-playback-dai-link {
			link-name = "MI2S-LPAIF-RX-PRIMARY";

			cpu {
				sound-dai = <0x236 0x10>;
			};

			codec {
				sound-dai = <0x237 0x02 0x238>;
			};

			platform {
				sound-dai = <0x239>;
			};
		};

		mi2s-capture-dai-link {
			link-name = "MI2S-LPAIF-TX-PRIMARY";

			cpu {
				sound-dai = <0x236 0x11>;
			};

			codec {
				sound-dai = <0x237 0x03 0x238>;
			};

			platform {
				sound-dai = <0x239>;
			};
		};

		quaternary-mi2s-playback-dai-link {
			link-name = "MI2S-LPAIF_RXTX-RX-PRIMARY";

			cpu {
				sound-dai = <0x236 0x16>;
			};

			codec {
				sound-dai = <0x237 0x02 0x23a>;
			};

			platform {
				sound-dai = <0x239>;
			};
		};
	};


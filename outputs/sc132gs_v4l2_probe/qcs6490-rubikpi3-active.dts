				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x14>;
			};

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x1e8480>;
				exit-latency-us = <0x2710>;
				phandle = <0x1e9>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x600>;
			clocks = <0x02 0x01>;
			enable-method = "psci";
			power-domains = <0x15>;
			power-domain-names = "psci";
			next-level-cache = <0x16>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x01>;
			#cooling-cells = <0x02>;

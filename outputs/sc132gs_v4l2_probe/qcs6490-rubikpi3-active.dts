			src-clock-name = "cam_cc_camnoc_axi_clk_src";
			clocks = <0x3a 0x0c 0x3a 0x0d 0x196 0x6a 0x196 0x1e 0x196 0x17 0x196 0x16 0x196 0x31 0x196 0x32>;

					#io-channel-cells = <0x01>;
					phandle = <0x1b3>;

					channel@44 {
						reg = <0x44>;
						label = "xo_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,ratiometric;
					};

					channel@103 {
						reg = <0x103>;
						label = "pm7325_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					channel@144 {
						reg = <0x144>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "pm7325_quiet_therm";

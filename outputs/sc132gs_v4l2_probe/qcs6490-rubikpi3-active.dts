				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x16>;
			};

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x1e8480>;
				exit-latency-us = <0x2710>;
				phandle = <0x1ec>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x700>;
			clocks = <0x02 0x02>;
			enable-method = "psci";
			power-domains = <0x17>;
			power-domain-names = "psci";
			next-level-cache = <0x18>;
			operating-points-v2 = <0x19>;
			capacity-dmips-mhz = <0x7c1>;
			dynamic-power-coefficient = <0x228>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x02>;
			#cooling-cells = <0x02>;
			phandle = <0x21>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;

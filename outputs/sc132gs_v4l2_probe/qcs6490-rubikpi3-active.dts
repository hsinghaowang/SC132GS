			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x1e8480>;
				exit-latency-us = <0x2710>;
				phandle = <0x1e2>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			clocks = <0x02 0x00>;
			enable-method = "psci";
			power-domains = <0x0e>;
			power-domain-names = "psci";
			next-level-cache = <0x0f>;
			operating-points-v2 = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x1d>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x09>;
				phandle = <0x0f>;
			};

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x1e8480>;
				exit-latency-us = <0x2710>;
				phandle = <0x1e4>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x400>;
			clocks = <0x02 0x01>;
			enable-method = "psci";
			power-domains = <0x10>;
			power-domain-names = "psci";
			next-level-cache = <0x11>;
			operating-points-v2 = <0x12>;
			capacity-dmips-mhz = <0x79a>;
			dynamic-power-coefficient = <0x208>;
			interconnects = <0x06 0x02 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			qcom,freq-domain = <0x02 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1e>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;

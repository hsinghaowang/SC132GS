/dts-v1/;
/plugin/;

/*
 * GS130WI stereo external-trigger wiring on RUBIK Pi 3 V02:
 * Hardware-verified GS130WI control routing on this cable/connector pair:
 *   camera 0: CCI1/0x32, CSIPHY1, RESET on TLMM57, FSYNC on TLMM18
 *   camera 1: CCI0/0x30, CSIPHY4, RESET on TLMM58, FSYNC on TLMM19
 *
 * Disable the unused fixed-regulator ownership of TLMM18/19.  The host FSYNC
 * generator owns both lines in one GPIO-v2 request and changes them together.
 */

/ {
	fragment@100 {
		target-path = "/soc@0/gpio-regulator@0";
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@101 {
		target-path = "/soc@0/gpio-regulator@1";
		__overlay__ {
			status = "disabled";
		};
	};
};

&cci0 {
	status = "okay";
};

&cci0_i2c0 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;

	sc132gs_cam1: camera@30 {
		compatible = "smartsens,sc132gs";
		reg = <0x30>;
		clocks = <&camcc 0x60>;
		clock-names = "xclk";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&cam2_default>;
		pinctrl-1 = <&cam2_suspend>;
		reset-gpios = <&tlmm 58 1>;
		smartsens,external-trigger;

		port {
			sc132gs_cam1_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0>;
				link-frequencies = /bits/ 64 <600000000>;
				remote-endpoint = <&camss_cam1_ep>;
			};
		};
	};
};

&cci1 {
	status = "okay";
};

&cci1_i2c0 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;

	sc132gs_cam0: camera@32 {
		compatible = "smartsens,sc132gs";
		reg = <0x32>;
		clocks = <&camcc 0x5c>;
		clock-names = "xclk";
		reset-gpios = <&tlmm 57 1>;
		smartsens,external-trigger;

		port {
			sc132gs_cam0_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0>;
				link-frequencies = /bits/ 64 <600000000>;
				remote-endpoint = <&camss_cam0_ep>;
			};
		};
	};
};

&camss {
	status = "okay";
	power-domain-names = "ife0", "ife1", "ife2", "top";
	clock-names = "camnoc_axi",
		"csi0", "csi1", "csi2", "csi3", "csi4",
		"csiphy0", "csiphy0_timer",
		"csiphy1", "csiphy1_timer",
		"csiphy2", "csiphy2_timer",
		"csiphy3", "csiphy3_timer",
		"csiphy4", "csiphy4_timer",
		"cpas_ahb", "gcc_camera_axi", "soc_ahb",
		"vfe0_axi", "vfe0", "vfe0_cphy_rx",
		"vfe1_axi", "vfe1", "vfe1_cphy_rx",
		"vfe2_axi", "vfe2", "vfe2_cphy_rx",
		"vfe0_lite", "vfe0_lite_cphy_rx",
		"vfe1_lite", "vfe1_lite_cphy_rx";
	vdda-phy-supply = <&vreg_l10c_0p88>;
	vdda-pll-supply = <&vreg_l6b_1p2>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			camss_cam0_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0>;
				remote-endpoint = <&sc132gs_cam0_ep>;
			};
		};

		port@4 {
			reg = <4>;
			camss_cam1_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0>;
				remote-endpoint = <&sc132gs_cam1_ep>;
			};
		};
	};
};
